<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Prefer explicit env vars; fall back to repo-local prebuilt artifacts extracted by get-webrtc-artifacts.ps1 -->
    <WebRtcSrcRoot Condition="'$(WEBRTC_SRC_PATH)' != ''">$(WEBRTC_SRC_PATH)</WebRtcSrcRoot>
    <WebRtcSrcRoot Condition="'$(WEBRTC_SRC_PATH)' == ''">$(MSBuildThisFileDirectory)..\third-party\google\webrtc\include</WebRtcSrcRoot>
    <WebRtcOutRoot Condition="'$(WEBRTC_OUT_PATH)' != ''">$(WEBRTC_OUT_PATH)</WebRtcOutRoot>
    <WebRtcOutRoot Condition="'$(WEBRTC_OUT_PATH)' == ''">$(MSBuildThisFileDirectory)..\third-party\google\webrtc\lib</WebRtcOutRoot>
    <WebRtcGoogletestRoot Condition="Exists('$(MSBuildThisFileDirectory)..\third-party\google\googletest\CMakeLists.txt')">$(MSBuildThisFileDirectory)..\third-party\google\googletest</WebRtcGoogletestRoot>
    <WebRtcGoogletestRoot Condition="'$(WebRtcGoogletestRoot)' == ''">$(WebRtcSrcRoot)\third_party\googletest\src</WebRtcGoogletestRoot>
    <!-- Treat artifacts as prebuilt when the env var says so OR when the repo-local artifact tree exists -->
    <WebRtcPrebuilt Condition="'$(WEBRTC_PREBUILT)' == '1' Or (Exists('$(MSBuildThisFileDirectory)..\third-party\google\webrtc\include') And Exists('$(MSBuildThisFileDirectory)..\third-party\google\webrtc\lib'))">1</WebRtcPrebuilt>
    <WebRtcPrebuilt Condition="'$(WebRtcPrebuilt)' == ''">0</WebRtcPrebuilt>
    <OutDir>bin\$(Platform)\$(Configuration)\$(TargetFrameworkVersion)$(TargetFramework)\</OutDir>
    <IntDir>obj\$(Platform)\$(Configuration)\$(TargetFrameworkVersion)$(TargetFramework)\</IntDir>
  </PropertyGroup>
</Project>
