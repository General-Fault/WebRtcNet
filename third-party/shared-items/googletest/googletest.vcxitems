<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <ItemsProjectGuid>{357b6b66-ab73-41cd-9271-1b4e5c41dde1}</ItemsProjectGuid>
    <CustomBuildBeforeTargets>Link</CustomBuildBeforeTargets>
    <WebRtcNetRepoRoot>$(MSBuildThisFileDirectory)..\..\..\</WebRtcNetRepoRoot>
    <GTestBuildDir>$(MSBuildThisFileDirectory)build\$(Platform)</GTestBuildDir>
  </PropertyGroup>
  <Import Project="$(WebRtcNetRepoRoot)WebRtcInterop\WebRtcInterop.BuildPaths.props" Condition="'$(WebRtcSrcRoot)' == '' Or '$(WebRtcGoogletestRoot)' == ''" />
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(MSBuildThisFileDirectory);$(WebRtcGoogletestRoot)\googletest\include;$(WebRtcGoogletestRoot)\googlemock\include</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>GTEST_IS_THREADSAFE=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>%(AdditionalLibraryDirectories);$(GTestBuildDir)\lib\$(Configuration);$(GTestBuildDir)\lib;$(MSBuildThisFileDirectory)lib\$(Configuration);$(MSBuildThisFileDirectory)lib\Debug</AdditionalLibraryDirectories>
      <AdditionalDependencies>gmock.lib;gtest.lib;gtest_main.lib</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup>
    <CustomBuildStep>
      <Command>cd "$(MSBuildThisFileDirectory)"
set "GTEST_CMAKE=$(DevEnvDir)CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe"
if not exist "%GTEST_CMAKE%" set "GTEST_CMAKE=$(VSINSTALLDIR)Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe"
if not exist "%GTEST_CMAKE%" set "GTEST_CMAKE=$(VCInstallDir)..\..\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe"
if not exist "%GTEST_CMAKE%" set "GTEST_CMAKE=cmake"
"%GTEST_CMAKE%" -S "$(WebRtcGoogletestRoot)" -B "$(GTestBuildDir)" -A "$(Platform)" -Dgtest_force_shared_crt=ON -Dgtest_disable_threadsafe=ON -Dgtest_disable_deathtest=ON
"%GTEST_CMAKE%" --build "$(GTestBuildDir)" --config "$(Configuration)"</Command>
      <Message>Building GoogleTest</Message>
      <Inputs>$(WebRtcGoogletestRoot)\CMakeLists.txt</Inputs>
      <Outputs>$(GTestBuildDir)\CMakeFiles\generate.stamp</Outputs>
    </CustomBuildStep>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectCapability Include="SourceItemsFromImports" />
  </ItemGroup>
</Project>
